GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-1.5-flash
# Supabase Postgres, same database as the backend. Empty = in-memory catalog.
DATABASE_URL=
# Shared secret; set the same value as AI_SERVICE_TOKEN on the backend.
AI_SERVICE_TOKEN=
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
